NEXT_PUBLIC_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=68d13a4a000d854004b3
# Server-only key: users.read, users.write, sessions.write
APPWRITE_API_KEY=
APP_URL=http://localhost:3000
APPWRITE_DATABASE_ID=mio
APPWRITE_NOTES_TABLE_ID=notes
APPWRITE_ATTACHMENTS_TABLE_ID=attachments
APPWRITE_ATTACHMENTS_BUCKET_ID=68d143bf001b9a793c30

# SMS web settings call the authenticated Appwrite Function. No Twilio secret is needed on the Site.
APPWRITE_SMS_FUNCTION_ID=mio-sms
# Optional provisioning-script overrides; keep credentials in .env.provisioning
APPWRITE_SMS_PROVIDER_ID=6ac51435002ef67f3ecd
MIO_SMS_WEBHOOK_URL=https://6ac51b26002d1520c40d.appwrite.network/inbound
