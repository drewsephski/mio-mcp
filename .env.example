NEXT_PUBLIC_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=68d13a4a000d854004b3
# Server-only key: users.read, users.write, sessions.write
APPWRITE_API_KEY=
APP_URL=http://localhost:3000
APPWRITE_DATABASE_ID=mio
APPWRITE_NOTES_TABLE_ID=notes
APPWRITE_ATTACHMENTS_TABLE_ID=attachments
APPWRITE_ATTACHMENTS_BUCKET_ID=68d143bf001b9a793c30

# SMS web settings call the authenticated Appwrite Function. No Twilio secret is needed on the Site.
APPWRITE_SMS_FUNCTION_ID=mio-sms
# Optional provisioning-script overrides; keep credentials in .env.provisioning
APPWRITE_SMS_PROVIDER_ID=6ac51435002ef67f3ecd
MIO_SMS_WEBHOOK_URL=https://6ac51b26002d1520c40d.appwrite.network/inbound

# Server-only SMS assistant variables. pnpm sms:configure-ai securely sets these
# on the Appwrite Function; a local key does not configure production.
OPENROUTER_API_KEY=
MIO_AI_MODEL=openai/gpt-5.6-luna
# Explicit fallback for users without prefs.timezone. SMS can save an override.
MIO_DEFAULT_TIMEZONE=America/Chicago
MIO_REMINDER_OFFSET_MINUTES=15

# Invite-only beta. Set the SAME allowlist on the Site and SMS Function.
# Empty means no new registrations or assistant access. Existing accounts can authenticate; normal beta pages require invitation.
MIO_INVITE_EMAILS=
# Public policy / support contact. Set before making the legal pages public.
MIO_SUPPORT_EMAIL=drewsepeczi@gmail.com
MIO_OPERATOR_NAME=Drew Sepeczi
# Dedicated Mio number is the production default. legacy-shared is a temporary
# compatibility mode for the development Vapi number only.
MIO_NUMBER_MODE=dedicated
# Function usage limits: all are validated nonnegative integers; cost ceilings positive.
MIO_MAX_INBOUND_PER_MINUTE=6
MIO_MAX_AI_PER_HOUR=30
MIO_MAX_AI_PER_DAY=100
MIO_MAX_OUTBOUND_PER_DAY=200
MIO_MAX_ACTIVE_REMINDERS=50
MIO_MAX_SCHEDULED_OUTBOUND=75
MIO_AI_TURN_CEILING_MICROS=250000
MIO_SMS_MESSAGE_CEILING_MICROS=500000
MIO_GLOBAL_AI_DAILY_MICROS=20000000
MIO_GLOBAL_SMS_DAILY_MICROS=10000000

# Exact verified Appwrite account ID; absent means operator access denied.
MIO_OPERATOR_USER_ID=
# Server-only readiness secret shared by Site, Function and release operator.
# Generate securely; minimum 32 characters. Never use an API key here.
MIO_OPERATIONS_TOKEN=
# Local operator evidence paths; never shipped to application runtimes.
MIO_LAUNCH_ATTESTATION=.workflow/twilio-launch.json
MIO_COHORT_EVIDENCE=.workflow/cohort-acceptance.json
