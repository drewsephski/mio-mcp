# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/functions/*/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Local evidence and generated artifacts
.impeccable/review/
.workflow/
.appwrite/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/functions/*/dist/
/functions/mio-sms/src/release.generated.ts
/apps/mobile/node_modules/
/apps/mobile/.expo/
/apps/mobile/dist/
/apps/mobile/ios/
/apps/mobile/android/
/packages/*/node_modules/
