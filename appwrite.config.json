  "functions": [
    {
      "$id": "mio-sms",
      "name": "Mio SMS Assistant",
      "runtime": "node-22",
      "execute": [
        "any"
      ],
      "enabled": true,
      "logging": true,
      "entrypoint": "dist/main.js",
      "commands": "corepack pnpm install --frozen-lockfile && corepack pnpm build",
      "events": [
        "tablesdb.mio.tables.sms_jobs.rows.*.create",
        "tablesdb.mio.tables.notes.rows.*.update",
        "tablesdb.mio.tables.notes.rows.*.delete",
        "tablesdb.mio.tables.reminders.rows.*.update"
      ],
      "schedule": "* * * * *",
      "timeout": 120,
      "scopes": [
        "rows.read",
        "rows.write",
        "users.read",
        "users.write",
        "targets.read",
        "targets.write",
        "messages.read",
        "messages.write"
      ],
      "buildSpecification": "s-2vcpu-2gb",
      "runtimeSpecification": "s-0.5vcpu-512mb",
      "deploymentRetention": 7,
      "path": ".appwrite/function"
    }
  ]
