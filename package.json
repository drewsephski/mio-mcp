{
  "name": "appwrite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm prepare:release && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "pnpm prepare:release && next typegen && tsc --noEmit && pnpm --dir functions/mio-sms typecheck",
    "test": "pnpm prepare:release && node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs functions/mio-sms/tests/*.test.ts",
    "appwrite:generate": "appwrite types lib/generated/appwrite.ts --language ts && appwrite types functions/mio-sms/src/generated.ts --language ts",
    "appwrite:deploy": "pnpm release:beta",
    "appwrite:verify": "node scripts/verify-appwrite.mjs",
    "sms:build": "pnpm prepare:release && pnpm --dir functions/mio-sms build",
    "sms:deploy": "pnpm release:beta",
    "sms:verify": "node --experimental-strip-types scripts/verify-sms.mjs",
    "sms:evaluate": "MIO_LIVE_EVAL=1 node --experimental-strip-types --test functions/mio-sms/tests/evaluation.test.ts",
    "sms:configure-ai": "node scripts/configure-sms-ai.mjs",
    "sms:verify-deployed": "node --experimental-strip-types scripts/verify-sms-deployed.mjs",
    "sms:configure-beta": "node scripts/configure-sms-beta.mjs",
    "prepare:release": "node scripts/prepare-release.mjs",
    "schema:beta": "node scripts/schema-beta.mjs",
    "release:beta": "node --experimental-strip-types scripts/release-beta.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "check:config": "node scripts/check-config.mjs",
    "launch:check": "node --experimental-strip-types scripts/check-launch.mjs",
    "release:rollback": "node scripts/rollback-beta.mjs",
    "beta:isolation": "node scripts/beta-isolation.mjs",
    "beta:cohort": "node scripts/cohort-beta.mjs",
    "mobile:dev": "pnpm --dir apps/mobile start",
    "mobile:ios": "pnpm --dir apps/mobile ios",
    "mobile:typecheck": "pnpm --dir apps/mobile typecheck",
    "mobile:export": "pnpm --dir apps/mobile export"
  },
  "dependencies": {
    "@appwrite.io/react": "^0.1.0",
    "@tanstack/react-query": "^5.104.1",
    "appwrite": "^25.2.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "node-appwrite": "^26.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.2"
}
