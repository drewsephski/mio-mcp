      "css": ".ds-label{display:block;font-size:13px;font-weight:550;margin-bottom:7px;color:var(--foreground);font-family:var(--font-geist-sans, Geist),sans-serif;}.ds-field{width:100%;border:1px solid #cfd7e4;border-radius:7px;padding:11px 12px;background:var(--background);color:var(--foreground);font-size:14px;caret-color:var(--blue);font-family:var(--font-geist-sans, Geist),sans-serif;}.ds-field::placeholder{color:#69778c;}.ds-field:focus-visible{outline:2px solid var(--blue);outline-offset:4px;}"
