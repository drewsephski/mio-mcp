      "css": ".ds-note{display:block;border-radius:8px;padding:16px 13px;margin-bottom:4px;color:var(--foreground);text-decoration:none;font-family:var(--font-geist-sans, Geist),sans-serif;}.ds-note:hover{background:var(--surface);}.ds-note.ds-selected{background:var(--pale);}.ds-note h2{margin:0;font-size:13px;font-weight:600;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}.ds-note p{margin:7px 0 0;color:var(--muted);font-size:12px;line-height:1.65;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.ds-note time{display:block;font-size:10px;color:var(--muted);margin-top:11px;}.ds-note:focus-visible{outline:2px solid var(--blue);outline-offset:4px;}"
